    - target: {fileID: 1137474750063054730, guid: 03b77f4eaaf41ce45a064df9bd292861, type: 3}
      propertyPath: m_Text
      value: "\n\uC624\uBBF8\uC790\uCC28(\u4E94\u5473\u5B50\u8336)\n\n\uB9D0\uB9B0
        \uC624\uBBF8\uC790 \uC5F4\uB9E4\uB97C \uB2EC\uC5EC \uB9CC\uB4E0 \uCC28.\n\n\uD55C\uC790\uC778
        '\uC624\uBBF8\uC790(\u4E94\u5473\u5B50)'\uC5D0\uC11C\uB3C4 \uC54C \uC218
        \uC788\uB4EF\uC774 \uB2E4\uC12F\uAC00\uC9C0 \uB9DB\uC744 \uACE0\uB8E8 \uAC16\uCD94\uACE0
        \uC788\uB2E4\uACE0 \uD558\uC5EC \uC624\uBBF8\uC790\uB77C\uACE0 \uBD88\uB9AC\uBA70,
        \uADF8 \uC911\uC5D0\uC11C \uC2E0\uB9DB\uC774 \uAC00\uC7A5 \uAC15\uD558\uAC8C
        \uB09C\uB2E4. \uADF8\uB807\uAE30 \uB54C\uBB38\uC5D0 \uB2E8\uB9DB\uC744 \uB0B4\uAE30
        \uC704\uD574 \uC124\uD0D5\uC774\uB098 \uAFC0\uC744 \uC11E\uC5B4\uB123\uAE30\uB3C4
        \uD55C\uB2E4.\n\n"
      objectReference: {fileID: 0}
