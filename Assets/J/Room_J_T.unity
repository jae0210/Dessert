--- !u!114 &279953854
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 279953852}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 812f0addf1d58a1469c2f688b34baf31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  myLegacyText: {fileID: 0}
  initialMessage: "\n\uC1A1\uD3B8 (\u677E\uD3B8)\n\n\uC1A1\uD3B8\uC740 \uB300\uD55C\uBBFC\uAD6D\uC758
    \uC804\uD1B5 \uB5A1 \uC911 \uD558\uB098\uB85C, \uD55C\uAD6D\uC5D0\uC11C\uB294
    \uC8FC\uB85C \uCD94\uC11D \uB54C \uBA39\uB294\uB2E4. \uBD81\uD55C\uC5D0\uC11C\uB294
    \uC124\uB0A0, \uC815\uC6D4\uB300\uBCF4\uB984 \uB4F1 \uAC01\uC885 \uAD6D\uAC00\uAE30\uB150\uC77C\uC5D0\uB3C4
    \uC1A1\uD3B8\uC744 \uBA39\uB294\uB2E4\uACE0 \uD55C\uB2E4. \uCD94\uC11D \uB54C
    \uBA39\uB294 \uC1A1\uD3B8\uC740 \uC624\uB824\uC1A1\uD3B8\uC774\uB77C\uACE0 \uB9D0\uD558\uACE0,
    \uC911\uD654\uC808\uC5D0 \uBA39\uB294 \uC1A1\uD3B8\uC740 \uB178\uBE44\uC1A1\uD3B8(\uB610\uB294
    \uC0AD\uC77C\uC1A1\uD3B8)\uC774\uB77C\uACE0 \uB9D0\uD55C\uB2E4.\r\n\r\n\uC1A1\uD3B8\uC740
    \uD55C\uAD6D\uC5D0\uB9CC \uC874\uC7AC\uD558\uB294 \uACE0\uC720\uD55C \uC694\uB9AC\uC774\uB2E4
    \uBCF4\uB2C8 \uB2F9\uC5F0\uD788 \uAC19\uC740 \uB3D9\uC544\uC2DC\uC544\uB77C \uD560\uC9C0\uB77C\uB3C4
    \uC911\uAD6D\uACFC \uC77C\uBCF8\uC5D0\uC11C\uB294 \uCC3E\uC544\uBCF4\uAE30 \uD798\uB4E4\uB2E4."
