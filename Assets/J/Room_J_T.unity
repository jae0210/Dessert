        \uAD6C\uC2AC\uACFC \uD654\uC0AC\uD55C \uBD04\uC758 \uBD84\uC704\uAE30\uAC00
        \uBAA8\uD2F0\uBE0C\uB85C \uB5A0\uC624\uB974\uB294 \uC0AC\uD0D5\uC774\uB2E4.
        \n\uC870\uC120 \uC2DC\uB300\uBD80\uD130 \uC804\uD574 \uB0B4\uB824\uC624\uB294
        \uC0AC\uD0D5\uC73C\uB85C, \uD604\uC7AC \uB098\uC624\uB294 \uBB3C\uAC74\uC740
        \uB300\uAC1C \uC300\uAC00\uB8E8\uB098 \uC5FF \uB300\uC2E0 \uBB3C\uC5FF\uC5D0
        \uC124\uD0D5\uC744 \uBC18\uBC18 \uC11E\uC5B4 \uB9CC\uB4E0\uB2E4.\n\r"
