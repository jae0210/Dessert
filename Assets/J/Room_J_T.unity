  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 812f0addf1d58a1469c2f688b34baf31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  myLegacyText: {fileID: 0}
  initialMessage: "\uAC00\uB798\uB5A1\n\n\uAC00\uB798 \uBC18\uC8FD\uC744 \uBE7B\uC544
    \uCA84\uB0B8 \uB4A4, \uB465\uAE00\uB824\uC11C \uAE38\uACE0 \uAC00\uB298\uAC8C
    \uB9CC\uB4E0 \uD770 \uB5A1\uC774\uB2E4. \uD55C\uAC08\uB798 \uC774\uB807\uAC8C
    \uB04A\uC5B4\uBA39\uB294\uB2E4\uACE0 \uD558\uC5EC \uAC08\uB798\uB5A1\uC5D0\uC11C
    \uC720\uB798\uB418\uC5C8\uB2E4\uB294 \uC124\uB3C4 \uC788\uAE34 \uD558\uB2E4.
    \uACBD\uC0C1\uB3C4 \uC77C\uBD80 \uC9C0\uC5ED\uC5D0\uC11C\uB294 '\uACE8\uBBF8\uB5A1'\uC774\uB77C\uACE0\uB3C4
    \uD55C\uB2E4. \uAD8C\uBAA8(\u62F3\u6A21)\uB77C\uACE0\uB3C4 \uD55C\uB2E4.\r\n"
