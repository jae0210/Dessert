MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1429538263}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 812f0addf1d58a1469c2f688b34baf31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  myLegacyText: {fileID: 0}
  initialMessage: "\n\uC30D\uD654\uCC28(\u96D9\u548C\u8336)\n\n\uC30D\uD654\uD0D5\uC744
    \uB2E8\uC21C\uD654\uD558\uC5EC \uB9CC\uB4E0 \uCC28.\r\n\r\n\uBC31\uC791\uC57D,
    \uC219\uC9C0\uD669, \uB2F9\uADC0, \uCC9C\uAD81, \uACC4\uD53C, \uAC10\uCD08\uB97C
    \uD0D5\uAE30\uC5D0\uC11C \uBB49\uADFC\uD788 \uB2EC\uC5EC \uB9C8\uC2E0\uB2E4.
    \uCDE8\uD5A5\uC5D0 \uB530\uB77C \uD638\uB450, \uC7A3, \uC740\uD589, \uBC24, \uD638\uBC15\uC528,
    \uB2EC\uAC40, \uC800\uBBFC \uC544\uBAAC\uB4DC, \uC800\uBBFC \uB300\uCD94 \uB4F1\uC774
    \uACE0\uBA85\uC73C\uB85C \uB4E4\uC5B4\uAC04\uB2E4.\n\n\uB2F9\uADC0, \uACC4\uD53C,
    \uAC10\uCD08 \uB4F1\uC744 \uB123\uC5B4\uC11C \uB2EC\uC778 \uB355\uBD84\uC5D0
    \uB2EC\uB2EC\uD558\uBA70, \uACE0\uBA85\uC5D0 \uB530\uB77C\uC11C \uC2DD\uC0AC
    \uB300\uC6A9\uC73C\uB85C\uB3C4 \uD6CC\uB96D\uD558\uB2E4. \uACC4\uB780\uAE4C\uC9C0
    \uB744\uC6CC\uC11C \uBD80\uC871\uD55C \uC601\uC591\uBD84\uC744 \uBCF4\uCDA9\uD558\uAE30\uB3C4
    \uD55C\uB2E4. \uCC38\uACE0\uB85C \uD2B9\uC720\uC758 \uAC80\uC740 \uC0C9\uAE54\uC740
    \uC219\uC9C0\uD669\uC5D0\uC11C \uC720\uB798\uB418\uB098 \uC2DC\uD310\uB418\uB294
    \uCC28\uC758 \uACBD\uC6B0 \uCE90\uB7EC\uBA5C \uC0C9\uC18C\uB97C \uCCA8\uAC00\uD558\uAE30\uB3C4
    \uD55C\uB2E4.\n"
